# Google OAuth 2.0 Client Credentials (from Google Cloud Console - Desktop app type)
GOOGLE_CLIENT_ID='YOUR_GOOGLE_CLIENT_ID_HERE'
GOOGLE_CLIENT_SECRET='YOUR_GOOGLE_CLIENT_SECRET_HERE'

# Path to the file where the user's OAuth tokens will be stored after first auth
# This file is created automatically. Default is .gcp-saved-tokens.json
TOKEN_FILE_PATH='.gcp-saved-tokens.json'

# Port for the local webserver during the OAuth callback (must match Google Cloud redirect URI)
OAUTH_CALLBACK_PORT=8080

# Google API Scopes
# Preferred: Provide all scopes as a single comma-separated list
# Example to enable Calendar (read/write) and Gmail send/list/read labels:
# GOOGLE_SCOPES='https://www.googleapis.com/auth/calendar, https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/gmail.send, https://www.googleapis.com/auth/gmail.labels'
GOOGLE_SCOPES=

# Backwards-compatible: you can also specify per-service scopes (comma-separated)
CALENDAR_SCOPES='https://www.googleapis.com/auth/calendar'
# Common Gmail scopes: gmail.readonly, gmail.send, gmail.labels
GMAIL_SCOPES='https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/gmail.send, https://www.googleapis.com/auth/gmail.labels'

# --- Microsoft Graph (Outlook, Teams, Calendar) Configuration ---

# IMPORTANT: Outlook and Teams use the SAME Microsoft Graph API
# They share the same Azure app credentials (CLIENT_ID and TENANT_ID)

# Microsoft Azure AD Application Credentials
# Register your app at: https://portal.azure.com/ -> Azure Active Directory -> App registrations

# Supported variable naming schemes (pick one):

# Option 1: Prefixed style (for organization)
OUT_CLIENT_ID='YOUR_MICROSOFT_CLIENT_ID_HERE'
OUT_CLIENT_SECRET='YOUR_MICROSOFT_CLIENT_SECRET_HERE'  # Optional: for confidential client apps
OUT_TENANT_ID='common'

# Option 2: MSFT style (recommended)
# MSFT_CLIENT_ID='YOUR_MICROSOFT_CLIENT_ID_HERE'
# MSFT_CLIENT_SECRET='YOUR_MICROSOFT_CLIENT_SECRET_HERE'  # Optional
# MSFT_TENANT_ID='common'

# Option 3: Generic style
# CLIENT_ID='YOUR_MICROSOFT_CLIENT_ID_HERE'
# CLIENT_SECRET='YOUR_MICROSOFT_CLIENT_SECRET_HERE'  # Optional
# TENANT_ID='common'

# Note: Use the SAME CLIENT_ID for both Outlook and Teams
# Both services authenticate through the same Azure app

# CLIENT_SECRET Configuration:
# - If provided: Uses Confidential Client flow (web app) - requires CLIENT_SECRET
# - If omitted: Uses Public Client flow (desktop app) - no CLIENT_SECRET needed
# - Confidential client apps need redirect URI like: http://localhost:8081
# - Public client apps need "Allow public client flows" enabled in Azure

# Optional: Path to store Microsoft Graph OAuth tokens
MSGRAPH_TOKEN_FILE='.msgraph-tokens.json'

# Optional: OAuth callback configuration
# REDIRECT_URI='http://localhost:8081'  # Or let it auto-generate
MSGRAPH_CALLBACK_PORT=8081

# Optional: Default Team and Channel for convenience endpoints
# If set, you can use /teams/default/* endpoints without specifying IDs
# TEAM_ID='f4c00439-546a-4af6-8fd8-de9eed82e1fb'
# CHANNEL_ID='19:abc123...@thread.tacv2'
# 
# Note: You can still use full endpoints with any team/channel ID:
# /teams/{team_id}/channels/{channel_id}/messages

# Microsoft Graph automatically uses these scopes:
# - Mail.ReadWrite (Outlook email access)
# - Mail.Send (Send emails)
# - Calendars.ReadWrite (Calendar access)
# - ChannelMessage.Read.All (Teams channel messages)
# - Chat.Read (Teams chat messages)
# - User.Read (Basic user profile)